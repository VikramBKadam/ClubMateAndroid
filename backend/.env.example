NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Supabase Postgres connection string.
# Use the server-side database URL from Supabase Project Settings > Database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true

# Keep secrets server-side. Do not put service-role keys in the iOS app.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30

# Local-only OTP bypass. Remove this in staging/production once MSG91/Twilio is wired.
DEV_OTP_CODE=123456

# Comma-separated origins, or * while developing.
CORS_ORIGIN=*

# Optional Supabase service config for storage/realtime integrations.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
